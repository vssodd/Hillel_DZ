    {
      "name": "Оновлення документа та перевірка змін",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус відповіді — 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "const requestData = JSON.parse(pm.request.body.raw);\r",
              "\r",
              "pm.test(\"Назва (title) успішно змінена\", function () {\r",
              "    pm.expect(jsonData.title).to.eql(requestData.title);\r",
              "});\r",
              "\r",
              "pm.test(\"Поле updatedAt існує\", function () {\r",
              "    pm.expect(jsonData.updatedAt).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Ціна (price) відповідає значенню в запиті\", function () {\r",
              "    pm.expect(jsonData.price).to.eql(requestData.price);\r",
              "});\r",
              "\r",
              "pm.test(\"Поле price має тип number\", function () {\r",
              "    pm.expect(jsonData.price).to.be.a('number');\r",
              "});\r",
              "\r",
              "pm.globals.set(\"last_car_title\", jsonData.title);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
