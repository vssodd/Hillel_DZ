  "item": [
    {
      "name": "Cтворення нового документа",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус відповіді — 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "const requestData = JSON.parse(pm.request.body ? pm.request.body.raw : '{}');",
              "",
              "pm.test(\"Назва (title) збігається з надісланою\", function () {",
              "    pm.expect(jsonData.title).to.eql(requestData.title);",
              "});",
              "",
              "pm.test(\"ID бренду (carBrandId) збігається з надісланим\", function () {",
              "    pm.expect(jsonData.carBrandId).to.eql(requestData.carBrandId);",
              "});",
              "",
              "pm.test(\"Поле title не є null\", function () {",
              "    pm.expect(jsonData.title).to.not.be.null;",
              "});",
              "",
              "pm.test(\"Поле title не є порожнім рядком\", function () {",
              "    pm.expect(jsonData.title).to.not.eql(\"\");",
              "});",
              "",
              "pm.test(\"Сервер повернув ID нового документа (_id)\", function () {",
              "    pm.expect(jsonData._id).to.exist;",
              "});",
              "",
              "pm.test(\"Поле title має тип string\", function () {",
              "    pm.expect(jsonData.title).to.be.a('string');",
              "});",
              "",
              "pm.globals.set(\"car_id\", jsonData._id);",
              "pm.globals.set(\"last_car_title\", jsonData.title);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const cars = [",
              "    \"BMW\", ",
              "    \"Audi\", ",
              "    \"Mercedes-Benz\", ",
              "    \"Volkswagen\", ",
              "    \"Porsche\", ",
              "    \"Lexus\", ",
              "    \"Toyota\", ",
              "    \"Honda\", ",
              "    \"Tesla\", ",
              "    \"Volvo\"",
              "];",
              "",
              "const randomCar = cars[Math.floor(Math.random() * cars.length)];",
              "",
              "pm.globals.set(\"randomCarName\", randomCar);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"carBrandId\":\"6984b21d93e5ca20b0fe5843\",\"title\":\"{{randomCarName}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/carsHillel",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "carsHillel"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Перевірка на наявність документа",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус відповіді — 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"ID документа збігається з глобальною змінною\", function () {\r",
              "    pm.expect(jsonData._id).to.eql(pm.globals.get(\"car_id\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Назва (title) збігається з очікуваною\", function () {\r",
              "    const expectedTitle = pm.globals.get(\"last_car_title\");\r",
              "    pm.expect(jsonData.title).to.eql(expectedTitle);\r",
              "});\r",
              "\r",
              "pm.test(\"Поле title не є null\", function () {\r",
              "    pm.expect(jsonData.title).to.not.be.null;\r",
              "});\r",
              "\r",
              "pm.test(\"Поле title не є порожнім рядком\", function () {\r",
              "    pm.expect(jsonData.title).to.not.eql(\"\");\r",
              "});\r",
              "\r",
              "pm.test(\"Поле title має тип string\", function () {\r",
              "    pm.expect(jsonData.title).to.be.a('string');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/carsHillel/{{car_id}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
