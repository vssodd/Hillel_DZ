    {
      "name": "Фільтрація та пошук",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус відповіді — 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "const car = jsonData[0];\r",
              "\r",
              "pm.test(\"Назва автомобіля збігається з очікуваною\", function () {\r",
              "    const expectedTitle = pm.globals.get(\"last_car_title\");\r",
              "    pm.expect(car.title).to.eql(expectedTitle);\r",
              "});\r",
              "\r",
              "pm.test(\"Ціна відповідає оновленим даним\", function () {\r",
              "    pm.expect(car.price).to.be.a('number');\r",
              "});\r",
              "\r",
              "pm.test(\"ID бренду (carBrandId) відповідає заданому\", function () {\r",
              "    pm.expect(car.carBrandId).to.eql(\"6984b21d93e5ca20b0fe5843\");\r",
              "});\r",
              "\r",
              "pm.test(\"Поле title не є порожнім або null\", function () {\r",
              "    pm.expect(car.title).to.not.be.null;\r",
              "    pm.expect(car.title).to.not.eql(\"\");\r",
              "});\r",
              "\r",
              "pm.test(\"Поле carBrandId заповнене\", function () {\r",
              "    pm.expect(car.carBrandId).to.not.be.null;\r",
              "});\r",
              "\r",
              "pm.test(\"Поле createdAt існує в документі\", function () {\r",
              "    pm.expect(car.createdAt).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Поле updatedAt існує в документі\", function () {\r",
              "    pm.expect(car.updatedAt).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
