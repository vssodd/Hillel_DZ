			"name": "2.Змінити йому всі данні",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const firstName = pm.variables.replaceIn('{{$randomFirstName}}');",
							"const lastName  = pm.variables.replaceIn('{{$randomLastName}}');",
							"const country   = pm.variables.replaceIn('{{$randomCountry}}');",
							"",
							"function getRandomDate(start, end) {",
							"  const d = new Date(start.getTime() + Math.random() * (end.getTime() - start.getTime()));",
							"  return d.toISOString().split('T')[0];",
							"}",
							"const dateBirth = getRandomDate(new Date(1980, 0, 1), new Date(2005, 0, 1));",
							"",
							"pm.environment.set('name', firstName);",
							"pm.environment.set('lastName', lastName);",
							"pm.environment.set('country', country);",
							"pm.environment.set('dateBirth', dateBirth);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// HTTP статус: 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Ответ содержит тело и это JSON\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.response.to.be.withBody;\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"// Статус сервиса: допускаем true / \"ok\" / \"OK\"\"\r",
							"pm.test(\"Service status OK:true\", function () {\r",
							"    let json;\r",
							"    try {\r",
							"        json = pm.response.json();\r",
							"    } catch (e) {\r",
							"        pm.expect.fail(\"Response is not valid JSON\");\r",
							"    }\r",
							"    pm.expect(json).to.have.property(\"status\");\r",
							"    pm.expect(json.status).to.include(\"ok\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
