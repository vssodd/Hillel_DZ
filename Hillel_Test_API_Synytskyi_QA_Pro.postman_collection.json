		{
			"name": "1.Створити користувача",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Flexible status code check: 201 for success, or common error codes",
							"pm.test(\"Status code is 201 (Created) or acceptable error\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([201, 400, 409, 422]);",
							"});",
							"",
							"// Response contains body and is JSON",
							"pm.test(\"Response is JSON\", function () {",
							"    pm.response.to.be.withBody;",
							"    pm.response.to.be.json;",
							"});",
							"",
							"// Check response status property safely",
							"pm.test(\"Response has status property\", function () {",
							"    let json;",
							"    try {",
							"        json = pm.response.json();",
							"    } catch (e) {",
							"        pm.expect.fail(\"Response is not valid JSON\");",
							"        return;",
							"    }",
							"    ",
							"    pm.expect(json).to.have.property(\"status\");",
							"    ",
							"    // If successful creation (201), status should be \"ok\"",
							"    if (pm.response.code === 201) {",
							"        pm.expect(json.status).to.eql(\"ok\");",
							"    }",
							"});",
							"",
							"// Additional test: If 201, verify user data in response",
							"pm.test(\"On success, response contains user data\", function () {",
							"    if (pm.response.code === 201) {",
							"        const json = pm.response.json();",
							"        pm.expect(json).to.have.property(\"data\");",
							"        pm.expect(json.data).to.have.property(\"userId\");",
							"    } else {",
							"        // Skip this test for error responses",
							"        console.log(\"Skipped user data check - response was not 201\");",
							"    }",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const firstNames = [\"Vlad\",\"Alex\",\"Maria\",\"Olena\",\"Ivan\",\"Sergii\",\"Nadia\",\"Dmytro\",\"Tetiana\",\"Oksana\"];",
							"const lastNames  = [\"Synytsky\",\"Ivanov\",\"Petrenko\",\"Shevchenko\",\"Kovalenko\",\"Bondarenko\",\"Melnyk\",\"Kravchuk\",\"Tkachenko\",\"Marchenko\"];",
							"",
							"const random_photo = \"avatar-\" + Math.floor(Math.random() * 1000) + \".png\";",
							"",
							"const random_email = \"vladodd\" + Math.floor(Math.random() * 10000) + \"@gmail.com\";",
							"const random_password = \"Pass\" + Math.floor(Math.random() * 10000) + \"A!\";",
							"",
							"const name = firstNames[Math.floor(Math.random() * firstNames.length)];",
							"const lastName = lastNames[Math.floor(Math.random() * lastNames.length)];",
							"",
							"pm.environment.set(\"name\", name);",
							"pm.environment.set(\"lastName\", lastName);",
							"pm.environment.set(\"random_email\", random_email);",
							"pm.environment.set(\"random_password\", random_password);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
