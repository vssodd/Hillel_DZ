		{
			"name": "1.1.Валідація профілю",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function randStr(prefix) {",
							"  return `${prefix}${Math.floor(Math.random()*10000)}`;",
							"}",
							"function randDate(startYear, endYear) {",
							"  const start = new Date(startYear, 0, 1).getTime();",
							"  const end = new Date(endYear, 0, 1).getTime();",
							"  const d = new Date(start + Math.random()*(end-start));",
							"  return d.toISOString().slice(0,10);",
							"}",
							"",
							"const base = {",
							"  name: randStr(\"Name_\"),",
							"  lastName: randStr(\"Last_\"),",
							"  dateBirth: randDate(1980, 2005),",
							"  country: \"Ukraine\"",
							"};",
							"",
							"const scenarios = [",
							"  { testName: \"Profile.name empty\", patch: { name: \"\" }, expectedStatus: 400, messageRe: /name/i },",
							"  { testName: \"Profile.lastName empty\", patch: { lastName: \"\" }, expectedStatus: 400, messageRe: /lastName/i },",
							"  { testName: \"Profile.country invalid\", patch: { country: \"1234\" }, expectedStatus: 400, messageRe: /country/i },",
							"  { testName: \"Profile.dateBirth invalid format\", patch: { dateBirth: \"11-06-2004\" }, expectedStatus: 400, messageRe: /dateBirth|date/i },",
							"  { testName: \"Happy path: valid profile update\", patch: {}, expectedStatus: 200, messageRe: null }",
							"];",
							"",
							"let i = pm.collectionVariables.get(\"profile_val_index\");",
							"i = i === undefined || i === null || i === \"\" ? 0 : parseInt(i, 10);",
							"pm.collectionVariables.set(\"profile_val_total\", scenarios.length);",
							"",
							"const s = scenarios[i] || scenarios[0];",
							"const payload = Object.assign({}, base, s.patch);",
							"",
							"pm.environment.set(\"name\", payload.name);",
							"pm.environment.set(\"lastName\", payload.lastName);",
							"pm.environment.set(\"country\", payload.country);",
							"pm.environment.set(\"dateBirth\", payload.dateBirth);",
							"",
							"pm.collectionVariables.set(\"expectedStatus\", s.expectedStatus);",
							"pm.collectionVariables.set(\"currentTestName\", s.testName);",
							"pm.collectionVariables.set(\"expectedMessageRe\", s.messageRe ? String(s.messageRe) : \"\");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const expectedStatus = parseInt(pm.collectionVariables.get(\"expectedStatus\"), 10);",
							"const testName = pm.collectionVariables.get(\"currentTestName\") || \"Unnamed scenario\";",
							"const msgReStr = pm.collectionVariables.get(\"expectedMessageRe\") || \"\";",
							"",
							"function safeJson() {",
							"  try { return pm.response.json(); } catch (e) { return null; }",
							"}",
							"const json = safeJson();",
							"",
							"pm.test(`Profile: status is ${expectedStatus} (${testName})`, () => {",
							"  pm.expect(pm.response.code).to.eql(expectedStatus);",
							"});",
							"",
							"if (expectedStatus >= 400) {",
							"  pm.test(`Profile: message matches (${testName})`, () => {",
							"    let ok = false;",
							"",
							"    if (json && typeof json === \"object\" && \"message\" in json) {",
							"      if (!msgReStr) {",
							"        ok = true;",
							"      } else {",
							"        const m = msgReStr.match(/^\\/(.+)\\/([gimsuy]*)$/);",
							"        if (m) {",
							"          const re = new RegExp(m[1], m[2]);",
							"          ok = re.test(String(json.message));",
							"        } else {",
							"          ok = true;",
							"        }",
							"      }",
							"    }",
							"",
							"    pm.expect(ok).to.eql(true);",
							"  });",
							"} else {",
							"  pm.test(\"Profile: ok response contract\", () => {",
							"    const dateOnly = json?.data?.dateBirth ? String(json.data.dateBirth).slice(0, 10) : \"\";",
							"",
							"    const ok =",
							"      !!json &&",
							"      json.status === \"ok\" &&",
							"      json.data &&",
							"      typeof json.data.userId === \"number\" &&",
							"      typeof json.data.photoFilename !== \"undefined\" &&",
							"      typeof json.data.name !== \"undefined\" &&",
							"      typeof json.data.lastName !== \"undefined\" &&",
							"      typeof json.data.dateBirth !== \"undefined\" &&",
							"      typeof json.data.country !== \"undefined\" &&",
							"      dateOnly === String(pm.environment.get(\"dateBirth\"));",
							"",
							"    pm.expect(ok).to.eql(true);",
							"  });",
							"}",
							"",
							"let i = pm.collectionVariables.get(\"profile_val_index\");",
							"i = i === undefined || i === null || i === \"\" ? 0 : parseInt(i, 10);",
							"",
							"const total = parseInt(pm.collectionVariables.get(\"profile_val_total\") || \"0\", 10);",
							"",
							"if (i < total - 1) {",
							"  pm.collectionVariables.set(\"profile_val_index\", i + 1);",
							"  pm.execution.setNextRequest(pm.info.requestName);",
							"} else {",
							"  pm.collectionVariables.set(\"profile_val_index\", 0);",
							"  pm.execution.setNextRequest(\"2.Змінити йому всі данні\");",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"lastName\": \"{{lastName}}\",\r\n  \"dateBirth\": \"{{dateBirth}}\",\r\n  \"country\": \"{{country}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BaseURL}}/users/profile",
					"host": [
						"{{BaseURL}}"
					],
					"path": [
						"users",
						"profile"
					]
				}
			},
			"response": []
		},
		{
			"name": "2.Змінити йому всі данні",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const firstName = pm.variables.replaceIn('{{$randomFirstName}}');",
							"const lastName  = pm.variables.replaceIn('{{$randomLastName}}');",
							"const country   = pm.variables.replaceIn('{{$randomCountry}}');",
							"",
							"function getRandomDate(start, end) {",
							"  const d = new Date(start.getTime() + Math.random() * (end.getTime() - start.getTime()));",
							"  return d.toISOString().split('T')[0];",
							"}",
							"",
							"const dateBirth = getRandomDate(new Date(2000, 0, 1), new Date(2005, 0, 1));",
							"",
							"pm.environment.set('name', firstName);",
							"pm.environment.set('lastName', lastName);",
							"pm.environment.set('country', country);",
							"pm.environment.set('dateBirth', dateBirth);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", () => {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is valid JSON\", () => {\r",
							"  pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"function getRequestBody() {\r",
							"  const raw = pm.request.body?.raw || \"{}\";\r",
							"  return JSON.parse(pm.variables.replaceIn(raw));\r",
							"}\r",
							"\r",
							"function getResponseData() {\r",
							"  const json = pm.response.json();\r",
							"  pm.expect(json).to.have.property(\"status\", \"ok\");\r",
							"  pm.expect(json).to.have.property(\"data\");\r",
							"  pm.expect(json.data).to.be.an(\"object\");\r",
							"  return json.data;\r",
							"}\r",
							"\r",
							"pm.test(\"Profile.name matches request\", () => {\r",
							"  const req = getRequestBody();\r",
							"  const data = getResponseData();\r",
							"  pm.expect(data.name).to.eql(req.name);\r",
							"});\r",
							"\r",
							"pm.test(\"Profile.lastName matches request\", () => {\r",
							"  const req = getRequestBody();\r",
							"  const data = getResponseData();\r",
							"  pm.expect(data.lastName).to.eql(req.lastName);\r",
							"});\r",
							"\r",
							"pm.test(\"Profile.country matches request\", () => {\r",
							"  const req = getRequestBody();\r",
							"  const data = getResponseData();\r",
							"  pm.expect(data.country).to.eql(req.country);\r",
							"});\r",
							"\r",
							"pm.test(\"Profile.dateBirth matches request (date-only)\", () => {\r",
							"  const req = getRequestBody();\r",
							"  const data = getResponseData();\r",
							"\r",
							"  const respDateOnly = String(data.dateBirth).slice(0, 10); // \"YYYY-MM-DD\"\r",
							"  pm.expect(respDateOnly).to.eql(req.dateBirth);\r",
							"});\r",
							"\r",
							"pm.test(\"Profile response includes required keys\", () => {\r",
							"  const data = getResponseData();\r",
							"  pm.expect(data).to.include.keys(\"userId\", \"photoFilename\", \"name\", \"lastName\", \"dateBirth\", \"country\");\r",
							"});\r",
							"\r",
							"pm.test(\"Profile.userId is a number\", () => {\r",
							"  const data = getResponseData();\r",
							"  pm.expect(data.userId).to.be.a(\"number\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"lastName\": \"{{lastName}}\",\r\n  \"dateBirth\": \"{{dateBirth}}\",\r\n  \"country\": \"{{country}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BaseURL}}/users/profile",
					"host": [
						"{{BaseURL}}"
					],
					"path": [
						"users",
						"profile"
					]
				}
			},
			"response": []
		},
