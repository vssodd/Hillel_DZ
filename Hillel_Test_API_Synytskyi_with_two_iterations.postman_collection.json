	"item": [
		{
			"name": "1.Створити користувача",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function uniqEmail() {",
							"  const ts = Date.now();",
							"  return `vlad_${ts}_${Math.floor(Math.random()*10000)}@gmail.com`;",
							"}",
							"function strongPass() {",
							"  return `Pass${Math.floor(Math.random()*9000+1000)}A!`;",
							"}",
							"",
							"const base = {",
							"  name: \"Vlad\",",
							"  lastName: \"Synytskyi\",",
							"  email: uniqEmail(),",
							"  password: strongPass()",
							"};",
							"",
							"const scenarios = [",
							"  { testName: \"Name is empty\",    patch: { name: \"\" }, expectedStatus: 400, messageRe: /name/i },",
							"  { testName: \"Name is 1 char\",   patch: { name: \"A\" }, expectedStatus: 400, messageRe: /name/i },",
							"  { testName: \"Name too long\",    patch: { name: \"VeryVeryLongNameThatIsInvalid\" }, expectedStatus: 400, messageRe: /name/i },",
							"  { testName: \"Name invalid chars\", patch: { name: \"Vlad123\" }, expectedStatus: 400, messageRe: /name/i },",
							"  { testName: \"lastName is empty\",  patch: { lastName: \"\" }, expectedStatus: 400, messageRe: /lastName/i },",
							"  { testName: \"Email invalid format\", patch: { email: \"not-an-email\" }, expectedStatus: 400, messageRe: /email/i },",
							"  { testName: \"Password too short\", patch: { password: \"123\" }, expectedStatus: 400, messageRe: /password/i },",
							"  { testName: \"Happy path: valid signup\", patch: {}, expectedStatus: 201, messageRe: null }",
							"];",
							"",
							"let i = pm.collectionVariables.get(\"signup_val_index\");",
							"i = i === undefined || i === null || i === \"\" ? 0 : parseInt(i, 10);",
							"pm.collectionVariables.set(\"signup_val_total\", scenarios.length);",
							"",
							"const s = scenarios[i] || scenarios[0];",
							"",
							"const payload = Object.assign({}, base, s.patch);",
							"",
							"pm.environment.set(\"name\", payload.name);",
							"pm.environment.set(\"lastName\", payload.lastName);",
							"pm.environment.set(\"random_email\", payload.email);",
							"pm.environment.set(\"random_password\", payload.password);",
							"pm.collectionVariables.set(\"expectedStatus\", s.expectedStatus);",
							"pm.collectionVariables.set(\"currentTestName\", s.testName);",
							"pm.collectionVariables.set(\"expectedMessageRe\", s.messageRe ? String(s.messageRe) : \"\");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const expectedStatus = parseInt(pm.collectionVariables.get(\"expectedStatus\"), 10);",
							"const testName = pm.collectionVariables.get(\"currentTestName\") || \"Unnamed scenario\";",
							"const msgReStr = pm.collectionVariables.get(\"expectedMessageRe\") || \"\";",
							"",
							"function safeJson() {",
							"  try { return pm.response.json(); } catch (e) { return null; }",
							"}",
							"const json = safeJson();",
							"",
							"pm.test(`Signup: status is ${expectedStatus} (${testName})`, () => {",
							"  pm.expect(pm.response.code).to.be.oneOf(expectedStatus === 201 ? [200, 201] : [expectedStatus]);",
							"});",
							"",
							"if (expectedStatus >= 400) {",
							"  pm.test(`Signup: message matches (${testName})`, () => {",
							"    let ok = false;",
							"",
							"    if (json && typeof json === \"object\" && \"message\" in json) {",
							"      if (!msgReStr) ok = true;",
							"      else {",
							"        const m = msgReStr.match(/^\\/(.+)\\/([gimsuy]*)$/);",
							"        if (m) ok = new RegExp(m[1], m[2]).test(String(json.message));",
							"        else ok = true;",
							"      }",
							"    }",
							"",
							"    pm.expect(ok).to.eql(true);",
							"  });",
							"} else {",
							"  pm.test(\"Signup: ok response contract\", () => {",
							"    const ok = !!json && json.status === \"ok\" && json.data && typeof json.data.userId === \"number\";",
							"    pm.expect(ok).to.eql(true);",
							"  });",
							"",
							"  if (json && json.data && typeof json.data.userId === \"number\") {",
							"    pm.environment.set(\"userId\", json.data.userId);",
							"  }",
							"}",
							"",
							"let i = pm.collectionVariables.get(\"signup_val_index\");",
							"i = i === undefined || i === null || i === \"\" ? 0 : parseInt(i, 10);",
							"",
							"const total = parseInt(pm.collectionVariables.get(\"signup_val_total\") || \"0\", 10);",
							"",
							"if (i < total - 1) {",
							"  pm.collectionVariables.set(\"signup_val_index\", i + 1);",
							"  pm.execution.setNextRequest(pm.info.requestName);",
							"} else {",
							"  pm.collectionVariables.set(\"signup_val_index\", 0);",
							"  pm.execution.setNextRequest(\"1.1.Валідація профілю\");",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"{{name}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{random_email}}\",\n  \"password\": \"{{random_password}}\",\n  \"repeatPassword\": \"{{random_password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BaseURL}}/auth/signup",
					"host": [
						"{{BaseURL}}"
					],
					"path": [
						"auth",
						"signup"
					]
				}
			},
			"response": []
